# VAK-SMS API key (from your VAK-SMS account)
VAK_API_KEY=your_vak_api_key_here

# Session secret (change in production)
SESSION_SECRET=change_me_to_random_secret

# Port
PORT=3000

# Admin login (first user with this email becomes admin)
ADMIN_EMAIL=admin@text2fa.com

# App URL (for webhooks, emails)
APP_URL=http://localhost:3000

# Site name (shown in header, titles, emails)
WEBSITE_NAME=Text2FA.COM

# Cryptomus deposits (https://doc.cryptomus.com/merchant-api/getting-api-keys)
CRYPTOMUS_API_KEY=your_payment_api_key
CRYPTOMUS_MERCHANT_ID=your_merchant_uuid
